{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-chatgpt-codex-usage",
  "version": "0.1.0",
  "description": "OpenCode TUI sidebar plugin for ChatGPT Codex usage limits",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "codex",
    "chatgpt",
    "tui"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "test": "npm run clean && npm run build && node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.18 <2",
    "@opentui/core": ">=0.4.5 <1",
    "@opentui/keymap": ">=0.4.5 <1",
    "@opentui/solid": ">=0.4.5 <1",
    "solid-js": ">=1.9.12 <2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.18",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^24.12.2",
    "solid-js": "1.9.12",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
